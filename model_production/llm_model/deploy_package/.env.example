# ============================================================
# TrainMindAI - LLM Model Pipeline
# Copia questo file come .env e compila con i tuoi valori
# ============================================================

# --- LLM Provider ---
# Opzioni: "openai" (API esterna) | "vllm" (self-hosted)
LLM_PROVIDER=openai

# --- OpenAI (usato se LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- vLLM (usato se LLM_PROVIDER=vllm) ---
# URL dell'endpoint vLLM (OpenAI-compatible)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=token-placeholder
LLM_MODEL=mistralai/Mistral-Small-3.1-24B-Instruct-2503

# --- Embeddings ---
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_DEVICE=cpu
# Opzioni EMBED_DEVICE: cpu | cuda | mps (Apple Silicon)

# --- Reranker ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# --- Vector Database ---
# Opzioni: "qdrant_local" | "qdrant_cloud" | "pinecone"
VECTOR_DB=qdrant_local

# Qdrant locale (Docker: docker run -p 6333:6333 qdrant/qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Qdrant Cloud (alternativa)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-api-key

# Pinecone (transitorio, se ancora in uso)
PINECONE_API_KEY=
PINECONE_INDEX=trainmind-kb

# --- Collection/Index names ---
KB_COLLECTION_NAME=trainmind_kb_v1
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=80

# --- Training (LoRA/QLoRA) ---
TRAINING_MODEL=mistralai/Mistral-Small-3.1-24B-Instruct-2503
TRAINING_OUTPUT_DIR=./outputs/lora
TRAINING_EPOCHS=3
TRAINING_BATCH_SIZE=4
TRAINING_GRAD_ACCUM=8
TRAINING_LR=2e-4
LORA_RANK=16
LORA_ALPHA=32

# --- Hugging Face ---
HF_TOKEN=hf_your-token-here

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Paths ---
KB_DOCS_PATH=./docs/kb
CHUNKS_OUTPUT_PATH=./data/chunks
SFT_DATASET_PATH=./data/sft
LORA_OUTPUT_PATH=./outputs/lora
