# Local LLM Configuration (primary — no API cost)
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=trainmind
LOCAL_LLM_TIMEOUT=120

# OpenAI Configuration (fallback LLM + embeddings)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_PREFIX=trainmind

# Database Configuration
DATABASE_URL=postgresql://trainmind:trainmind_dev@localhost:5432/trainmind_dev

# Service Configuration
AI_SERVICE_PORT=3002
AI_SERVICE_HOST=0.0.0.0
LOG_LEVEL=info
