# TrainMind — API Environment Variables

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://trainmind:trainmind_dev@localhost:5432/trainmind_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# AI Service
AI_SERVICE_URL=http://localhost:8000

# URL pubblico della web-app: usato per costruire il link di reset password
# inviato via email. In produzione va l'URL HTTPS reale.
APP_PUBLIC_URL=http://localhost:3000

# Email (Resend). Se la chiave manca o inizia con "re_xxx", il servizio va in
# modalita log-only: le email non partono e il link di reset viene stampato
# nei log del server. Perfetto per i test in locale.
RESEND_API_KEY=re_xxx_placeholder

# Mittente dei report programmati.
REPORT_FROM_EMAIL=TrainMind <onboarding@resend.dev>

# Mittente delle email di autenticazione (reset password). Se non definita si
# ricade su REPORT_FROM_EMAIL. Il dominio DEVE essere verificato su Resend,
# altrimenti l'invio fallisce con 403.
# Esempio in produzione (dominio trainmind-app.com già verificato su Resend):
#   AUTH_FROM_EMAIL=TrainMind <noreply@trainmind-app.com>
AUTH_FROM_EMAIL=
