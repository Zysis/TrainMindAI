# ============================================
# TrainMind AI — Variabili per il deploy su VPS
# Copia questo file in .env.deploy e compila i valori.
# NON committare .env.deploy su Git.
# ============================================

# ─── Domini (record A puntati all'IP del VPS) ─────────
APP_DOMAIN=app.tuodominio.com
API_DOMAIN=api.tuodominio.com
ATHLETE_DOMAIN=atleti.tuodominio.com

# ─── Database ─────────────────────────────────────────
POSTGRES_USER=trainmind
# Genera con: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIAMI_password_forte
POSTGRES_DB=trainmind_db

# ─── Auth ─────────────────────────────────────────────
# Metti a true per chiudere le registrazioni pubbliche (gli inviti atleti restano attivi)
DISABLE_REGISTRATION=false
# Genera con: openssl rand -hex 32
JWT_SECRET=CAMBIAMI_stringa_casuale_di_almeno_32_caratteri

# ─── OpenAI (obbligatoria per l'ai-service) ───────────
OPENAI_API_KEY=sk-...
# Modello di ripiego, usato solo se il routing per operazione qui sotto
# non specifica nulla.
OPENAI_MODEL=gpt-4o

# ─── Routing modelli AI ───────────────────────────────
# Quale modello usa ogni operazione. gpt-4o costa ~16 volte gpt-4o-mini:
# tenerlo su tutto significa pagare ~4,50 €/mese per cliente invece di ~0,76 €.
# Il modello completo resta solo dove la qualità paga: generazione dei piani
# (output lungo e strutturato) e Return-to-Play (ambito clinico).
# Per cambiare modello basta modificare qui e riavviare l'API.
AI_MODEL_CHAT=gpt-4o-mini
AI_MODEL_COACH=gpt-4o-mini
AI_MODEL_WELLNESS=gpt-4o-mini
AI_MODEL_REPORT=gpt-4o-mini
AI_MODEL_GENERATE=gpt-4o
AI_MODEL_RTP=gpt-4o

# Messaggi di storico chat inviati al modello a ogni turno.
# Ogni chiamata rimanda l'intera conversazione: senza limite il costo di una
# sessione lunga cresce in modo quadratico.
AI_CHAT_HISTORY_LIMIT=10

# In produzione non gira alcun server llama-cpp. Senza questo flag l'ai-service
# tenta un health check destinato a fallire prima di ogni chiamata a OpenAI,
# aggiungendo latenza a ogni richiesta.
LOCAL_LLM_ENABLED=false

# ─── Email (Resend) — reset password + inviti atleti + report ──────────
# Ottieni la API key gratis su https://resend.com/api-keys
# Senza chiave: le email vengono solo loggate (modalità "log-only").
# All'avvio l'API stampa una riga "Email: ..." che dichiara la modalità attiva.
RESEND_API_KEY=re_...

# Mittente dei report programmati.
REPORT_FROM_EMAIL=TrainMind AI <noreply@trainmind-app.com>

# Mittente delle email di autenticazione (reset password). Se vuota si ricade
# su REPORT_FROM_EMAIL. Il dominio deve essere verificato su Resend: con
# "onboarding@resend.dev" si possono raggiungere SOLO gli indirizzi del
# proprietario dell'account Resend, tutti gli altri ricevono 403.
AUTH_FROM_EMAIL=TrainMind AI <noreply@trainmind-app.com>

# ─── Stripe (opzionale, chiavi TEST per i test) ───────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
