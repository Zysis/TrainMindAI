# ============================================
# TrainMind AI — Root Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ─── General ─────────────────────────────────────────
NODE_ENV=development

# ─── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://trainmind:trainmind_dev@localhost:5432/trainmind_db

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ──────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ─── JWT Authentication ─────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI Service ──────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# OPENAI_API_KEY=sk-...
# PINECONE_API_KEY=...
# PINECONE_INDEX=trainmind-knowledge
