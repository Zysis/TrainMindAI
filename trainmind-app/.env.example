# ============================================
# TrainMind AI — Root Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ─── General ─────────────────────────────────────────
NODE_ENV=development

# ─── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://trainmind:trainmind_dev@localhost:5432/trainmind_db

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ──────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ─── JWT Authentication ─────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI Service ──────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# PINECONE_API_KEY=...
# PINECONE_INDEX=trainmind-knowledge

# ─── Routing modelli AI ──────────────────────────────
# Modello per operazione. gpt-4o costa ~16 volte gpt-4o-mini: resta solo
# dove la qualità paga (generazione piani, Return-to-Play).
AI_MODEL_CHAT=gpt-4o-mini
AI_MODEL_COACH=gpt-4o-mini
AI_MODEL_WELLNESS=gpt-4o-mini
AI_MODEL_REPORT=gpt-4o-mini
AI_MODEL_GENERATE=gpt-4o
AI_MODEL_RTP=gpt-4o

# Messaggi di storico chat inviati al modello a ogni turno.
AI_CHAT_HISTORY_LIMIT=10

# false quando non gira un server llama-cpp locale (caso normale).
LOCAL_LLM_ENABLED=false
