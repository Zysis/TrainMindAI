# =====================================================
# TrainMind AI MOBILE — Environment Variables
# =====================================================
# Copia questo file in .env.local e modifica solo se serve.

# IMPORTANTE: lascia NEXT_PUBLIC_API_URL VUOTO.
# Quando è vuoto, le chiamate API dal browser sono relative
# (es. /api/v1/...) e Next.js le inoltra automaticamente
# al backend di trainmind-app tramite il proxy interno.
# Cosi' niente problemi di CORS.
NEXT_PUBLIC_API_URL=

# URL pubblico della web-app mobile (porta 3003 di default).
# (3002 e' occupata dal container ai-service.)
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_APP_NAME=TrainMind AI

# Server-only: indirizzo backend trainmind-app/api (sviluppo locale).
# In produzione metti l'URL pubblico HTTPS (es. https://api.trainmind.tuodominio.com)
API_INTERNAL_URL=http://localhost:3001

# Server-only: indirizzo container AI service (FastAPI + LLM locale).
# Lo proxy mobile lo espone come /api/ai-svc/* lato browser.
AI_INTERNAL_URL=http://localhost:3002
