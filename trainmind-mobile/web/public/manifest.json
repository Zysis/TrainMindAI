{
  "name": "TrainMind AI",
  "short_name": "TrainMind",
  "description": "Piattaforma AI per preparatori fisici nel basket",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0D3B3B",
  "background_color": "#F8FAFC",
  "lang": "it",
  "dir": "ltr",
  "categories": ["sports", "fitness", "health"],
  "icons": [
    { "src": "/icons/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-512x512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Visualizza il dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/icons/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Calendario",
      "short_name": "Calendario",
      "description": "Apri il calendario allenamenti",
      "url": "/dashboard/calendar",
      "icons": [{ "src": "/icons/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Atleti",
      "short_name": "Atleti",
      "description": "Gestisci atleti e team",
      "url": "/dashboard/teams",
      "icons": [{ "src": "/icons/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "AI Chat",
      "short_name": "AI",
      "description": "Apri assistente AI",
      "url": "/dashboard/chat",
      "icons": [{ "src": "/icons/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/png", "image/jpeg", "image/webp"]
        }
      ]
    }
  }
}
